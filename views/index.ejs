<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Perusahaan Air Minum Daerah — Cek Tagihan Air</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#dbeafe',
              200: '#b8d4f0',
              300: '#7ab2e6',
              400: '#54a2ff',
              500: '#1a6bc4',
              600: '#0d2d52',
              700: '#0b2341',
              800: '#081a30',
              900: '#020618',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#f8fafc]">
  <!-- ======== NAVBAR ======== -->
  <nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <span class="text-lg font-bold text-brand-700">Perusahaan Air Minum Daerah</span>
      </a>
    </div>
  </nav>

  <!-- ======== HERO ======== -->
  <div class="bg-gradient-to-br from-brand-700 via-brand-600 to-brand-800">
    <div class="max-w-6xl mx-auto px-4 py-24 text-center">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-5">Cek Tagihan Air</h1>
      <p class="text-blue-200/80 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
        Cek tagihan air Perusahaan Air Minum Daerah dengan mudah — cukup masukkan nomor sambung pelanggan Anda
      </p>
    </div>
  </div>

  <!-- ======== CEK TAGIHAN CARD ======== -->
  <div class="max-w-3xl mx-auto px-4 -mt-10 relative z-10">
    <div class="bg-white rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 p-6 md:p-8">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-10 h-10 bg-brand-50 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-brand-800">Cek Tagihan</h2>
          <p class="text-sm text-gray-500">Masukkan nomor sambung pelanggan Anda</p>
        </div>
      </div>

      <form method="GET" action="/" class="flex flex-col sm:flex-row gap-3">
        <input type="text" name="no_sambung" placeholder="Contoh: TA2023001" value="<%= no_sambung %>"
          class="flex-1 px-5 py-3.5 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-brand-400 focus:border-brand-400 outline-none text-lg">
        <button type="submit" class="px-10 py-3.5 bg-brand-700 text-white rounded-xl hover:bg-brand-600 transition font-semibold text-lg shadow-sm shadow-brand-700/20">Cari</button>
      </form>

      <div class="mt-4 flex flex-wrap gap-2 text-xs text-gray-400">
        <span>Coba: TA2023001</span>
        <span>·</span>
        <span>TA2023002</span>
        <span>·</span>
        <span>TA2023003</span>
      </div>
    </div>
  </div>

  <!-- ======== CONTENT ======== -->
  <div class="max-w-4xl mx-auto px-4 py-10">
    <% if (locals.error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-xl mb-6 text-sm"><%= error %></div>
    <% } %>

    <% if (locals.bills && bills.length > 0) { %>
      <div class="bg-white rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 overflow-hidden">
        <!-- Customer info header -->
        <div class="px-6 py-6 bg-gradient-to-r from-brand-50 to-brand-100 border-b border-gray-100">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-brand-700 rounded-full flex items-center justify-center text-white font-bold text-xl">
              <%= bills[0].nama.charAt(0) %>
            </div>
            <div>
              <p class="font-bold text-brand-800 text-xl"><%= bills[0].nama %></p>
              <p class="text-sm text-gray-500"><%= bills[0].alamat %>, <%= bills[0].kecamatan %></p>
            </div>
          </div>
        </div>

        <!-- Bills table -->
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-100 bg-[#f8fafc]">
                <th class="text-left px-6 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">Periode</th>
                <th class="text-right px-6 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">Pemakaian</th>
                <th class="text-right px-6 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">Tagihan</th>
                <th class="text-center px-6 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              <% bills.forEach(function(b) { %>
                <tr class="hover:bg-brand-50/30">
                  <td class="px-6 py-4 text-sm font-medium text-brand-800"><%= b.bulan %>/<%= b.tahun %></td>
                  <td class="px-6 py-4 text-sm text-right text-gray-500"><%= b.pemakaian_m3 %> m³</td>
                  <td class="px-6 py-4 text-sm text-right font-semibold text-brand-800">Rp <%= Number(b.tagihan).toLocaleString('id-ID') %></td>
                  <td class="px-6 py-4 text-center">
                    <% if (b.status_bayar === 'lunas') { %>
                      <span class="text-xs bg-[#f0fdf4] text-[#00c758] font-semibold px-3 py-1 rounded-full">Lunas</span>
                    <% } else if (b.status_bayar === 'denda') { %>
                      <span class="text-xs bg-yellow-50 text-yellow-600 font-semibold px-3 py-1 rounded-full">Denda</span>
                    <% } else { %>
                      <span class="text-xs bg-red-50 text-red-500 font-semibold px-3 py-1 rounded-full">Belum Bayar</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Summary -->
        <% var belumBayar = bills.filter(b => b.status_bayar === 'belum'); %>
        <% if (belumBayar.length > 0) { %>
        <div class="px-6 py-4 bg-orange-50 border-t border-gray-100">
          <div class="flex justify-between items-center">
            <span class="text-sm font-medium text-orange-700"><%= belumBayar.length %> tagihan belum dibayar</span>
            <span class="font-bold text-orange-700">Rp <%= Number(belumBayar.reduce((a,b) => a + Number(b.tagihan) + Number(b.denda), 0)).toLocaleString('id-ID') %></span>
          </div>
          <p class="text-xs text-orange-500 mt-1">Bayar melalui mitra pembayaran: BCA, BJB, Mandiri, Alfamart, Indomaret, Tokopedia</p>
        </div>
        <% } %>
      </div>
    <% } else if (no_sambung && bills && bills.length === 0) { %>
      <div class="bg-white rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 p-10 text-center">
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="text-brand-800 font-medium text-lg">Tagihan Tidak Ditemukan</p>
        <p class="text-sm text-gray-500 mt-1">Nomor sambung <strong><%= no_sambung %></strong> tidak ditemukan</p>
        <p class="text-xs text-gray-400 mt-3">Pastikan nomor sambung sudah benar. Hubungi helpdesk jika membutuhkan bantuan.</p>
      </div>
    <% } %>
  </div>

  <!-- ======== LAYANAN ======== -->
  <div class="bg-white border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 py-16">
      <h2 class="text-2xl font-bold text-brand-800 text-center mb-10">Layanan Pelanggan</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
        <a href="#" class="bg-brand-50 rounded-2xl p-6 hover:shadow-lg hover:shadow-brand-100/50 transition border border-brand-100 group">
          <div class="w-12 h-12 bg-brand-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-105 transition">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 10a4 4 0 00-4-4H8a4 4 0 00-4 4v4a4 4 0 004 4h6a4 4 0 004-4v-1m-4 1l4-4m0 0l4 4m-4-4v12"/>
            </svg>
          </div>
          <h3 class="font-semibold text-brand-800 mb-1">Layanan Pengaduan</h3>
          <p class="text-sm text-gray-500">Laporkan gangguan atau keluhan layanan air</p>
        </a>
        <a href="#" class="bg-brand-50 rounded-2xl p-6 hover:shadow-lg hover:shadow-brand-100/50 transition border border-brand-100 group">
          <div class="w-12 h-12 bg-brand-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-105 transition">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-brand-800 mb-1">Aplikasi Pelanggan</h3>
          <p class="text-sm text-gray-500">Download aplikasi mobile cek tagihan & info pelanggan</p>
        </a>
      </div>
    </div>
  </div>

  <!-- ======== MITRA PEMBAYARAN ======== -->
  <div class="bg-[#f1f5f9] border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 py-14">
      <h2 class="text-xl font-bold text-brand-800 text-center mb-8">Mitra Pembayaran</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <% ['BCA','BJB','BNI','BRI','Mandiri','Danamon','BTN','Alfamart','Indomaret','POS Indonesia','Tokopedia'].forEach(function(m) { %>
          <span class="bg-white px-5 py-2.5 rounded-xl border border-gray-200 text-sm font-medium text-gray-600 shadow-sm"><%= m %></span>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- ======== TENTANG PERUSAHAAN ======== -->
  <div class="bg-white border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-2xl font-bold text-brand-800 mb-4">Tentang Perusahaan</h2>
          <p class="text-gray-500 leading-relaxed mb-6">
            Perusahaan Air Minum Daerah adalah Badan Usaha Milik Daerah pengelola air minum yang berkomitmen menyediakan air bersih untuk masyarakat.
          </p>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-brand-50 rounded-xl p-4 text-center border border-brand-100">
              <p class="text-2xl font-bold text-brand-700">106.526+</p>
              <p class="text-xs text-gray-500">Pelanggan Aktif</p>
            </div>
            <div class="bg-[#f0fdf4] rounded-xl p-4 text-center border border-green-100">
              <p class="text-2xl font-bold text-[#00c758]">11</p>
              <p class="text-xs text-gray-500">Kecamatan Terjangkau</p>
            </div>
            <div class="bg-[#fefce8] rounded-xl p-4 text-center border border-yellow-200">
              <p class="text-2xl font-bold text-yellow-600">Halal</p>
              <p class="text-xs text-gray-500">Air Bersertifikat Halal</p>
            </div>
            <div class="bg-brand-50 rounded-xl p-4 text-center border border-brand-100">
              <p class="text-2xl font-bold text-brand-700">ISO</p>
              <p class="text-xs text-gray-500">9001, 14001, 45001, 17025, 37001</p>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-brand-700 via-brand-600 to-brand-800 rounded-2xl p-8 text-white shadow-xl shadow-brand-700/10">
          <h3 class="font-bold text-xl mb-4">Visi Kami</h3>
          <p class="text-blue-200/80 italic mb-6 leading-relaxed">
            "Menjadi Perusahaan Air Minum dengan kinerja terbaik melalui pelayanan prima dan berwawasan lingkungan"
          </p>
          <h4 class="font-semibold mb-3">Misi</h4>
          <ul class="space-y-2.5 text-sm text-blue-200/80">
            <li class="flex gap-2"><span class="text-blue-300 mt-0.5">•</span> Memberikan layanan prima dan meningkatkan cakupan pelayanan pelanggan</li>
            <li class="flex gap-2"><span class="text-blue-300 mt-0.5">•</span> Meningkatkan kinerja keuangan dan operasional secara akuntabel dan profesional</li>
            <li class="flex gap-2"><span class="text-blue-300 mt-0.5">•</span> Meningkatkan kesejahteraan dan kualitas SDM perusahaan</li>
            <li class="flex gap-2"><span class="text-blue-300 mt-0.5">•</span> Mendorong pertumbuhan ekonomi dan investasi daerah</li>
            <li class="flex gap-2"><span class="text-blue-300 mt-0.5">•</span> Meningkatkan peran aktif dalam pelestarian lingkungan</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- ======== FOOTER ======== -->
  <footer class="bg-brand-700 text-gray-300">
    <div class="max-w-6xl mx-auto px-4 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="text-white font-bold text-lg">Perusahaan Air Minum Daerah</span>
          </div>
          <p class="text-sm text-gray-400">Badan Usaha Milik Daerah Pengelola Air Minum</p>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-4">Kontak</h4>
          <ul class="space-y-2 text-sm text-gray-400">
            <li>Jl. Contoh No. 1</li>
            <li>Kec. Contoh, Kota Contoh</li>
            <li>Kode Pos 00000</li>
            <li>Telp: (021) 0000-0000</li>
            <li>Email: info@example.com</li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-4">Layanan</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="text-gray-400 hover:text-white transition">Helpdesk Pengaduan</a></li>
            <li><a href="/" class="text-gray-400 hover:text-white transition">Cek Tagihan Online</a></li>
            <li><a href="#" class="text-gray-400 hover:text-white transition">Aplikasi Pelanggan</a></li>
            <li><a href="#" class="text-gray-400 hover:text-white transition">E-Procurement</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-600/30 mt-10 pt-8 text-center text-sm text-gray-500">
        <p>© 2026 Perusahaan Air Minum Daerah. All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>
