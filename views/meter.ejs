<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Input Meter — Perusahaan Air Minum Daerah</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
  <nav class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex justify-between h-16 items-center">
        <a href="/dashboard" class="text-lg font-bold text-blue-800">Perusahaan Air Minum Daerah</a>
        <div class="flex items-center gap-2 sm:gap-4 flex-wrap justify-end">
          <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full"><%= user.role %></span>
          <span class="text-sm text-gray-600"><%= user.nama_lengkap %></span>
          <a href="/logout" class="text-sm text-red-500 hover:text-red-700">Logout</a>
        </div>
      </div>
    </div>
  </nav>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-4 sm:py-6">
    <a href="/dashboard" class="text-sm text-blue-600 hover:text-blue-800 mb-4 inline-block">← Dashboard</a>

    <div class="bg-white rounded-xl shadow-sm border p-4 sm:p-6">
      <h2 class="text-xl font-bold text-gray-800 mb-2">Input Pemakaian Meter</h2>
      <p class="text-sm text-gray-500 mb-6">Catat pemakaian air bulanan & generate tagihan otomatis</p>

      <% if (locals.error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm"><%= error %></div>
      <% } %>

      <% if (locals.success) { %>
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">
          ✅ <%= success %>
          <% if (locals.customer) { %>
            <div class="mt-1">
              <strong><%= customer.nama %></strong> (<%= customer.no_sambung %>) —
              Periode <%= customer.bulan %>/<%= customer.tahun %> —
              Rp <%= Number(customer.tagihan).toLocaleString('id-ID') %>
            </div>
          <% } %>
        </div>
      <% } %>

      <form action="/meter" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">ID Pelanggan</label>
          <input type="text" name="customer_id" placeholder="Contoh: 1" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
          <p class="text-xs text-gray-400 mt-1">Cek ID di <a href="/customers" class="text-blue-500 hover:underline">Data Pelanggan</a></p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Bulan (1-12)</label>
            <input type="text" name="bulan" placeholder="10" required
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Tahun</label>
            <input type="text" name="tahun" placeholder="2026" required
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Pemakaian (m³)</label>
          <input type="text" name="pemakaian_m3" placeholder="Contoh: 30" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
          <p class="text-xs text-gray-400 mt-1">Tagihan dihitung otomatis: pemakaian × tarif pelanggan</p>
        </div>
        <button type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2.5 rounded-lg transition">
          Buat Tagihan
        </button>
      </form>
    </div>
  </div>
</body>
</html>