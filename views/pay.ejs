<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bayar Tagihan — PDAM Tirta Asasta Depok</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <nav class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex justify-between h-16 items-center">
        <a href="/dashboard" class="text-base sm:text-lg font-bold text-blue-800 truncate mr-2">PDAM Tirta Asasta Depok</a>
        <div class="flex items-center gap-2 sm:gap-4 shrink-0">
          <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full whitespace-nowrap"><%= user.role %></span>
          <span class="text-xs sm:text-sm text-gray-600 truncate max-w-[100px] sm:max-w-[200px]"><%= user.nama_lengkap %></span>
          <a href="/logout" class="text-xs sm:text-sm text-red-500 hover:text-red-700 whitespace-nowrap">Logout</a>
        </div>
      </div>
    </div>
  </nav>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-4 sm:py-8">
    <a href="/bill/<%= bill.id %>" class="text-sm text-blue-600 hover:text-blue-800 mb-4 inline-flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Kembali ke detail tagihan
    </a>

    <div class="bg-white rounded-xl shadow-sm border p-5 sm:p-8">
      <div class="text-center border-b pb-4 mb-6">
        <h2 class="text-base sm:text-lg font-bold text-gray-800">Pembayaran Tagihan Air</h2>
        <p class="text-xs sm:text-sm text-gray-500">PDAM Tirta Asasta Depok (Perseroda)</p>
      </div>

      <% if (locals.success) { %>
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-4 sm:py-5 rounded-lg mb-6 text-sm sm:text-base text-center">
          <div class="flex items-center justify-center gap-2 mb-1">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="font-medium"><%= success %></span>
          </div>
          <div class="mt-2"><a href="/bill/<%= bill.id %>" class="text-green-600 underline font-medium">Lihat detail tagihan →</a></div>
        </div>
      <% } %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 sm:gap-y-3 text-sm sm:text-base mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center">
          <span class="text-gray-500 text-xs sm:text-sm">Pelanggan</span>
          <span class="font-medium sm:ml-2"><%= bill.nama %></span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center">
          <span class="text-gray-500 text-xs sm:text-sm">No. Sambung</span>
          <span class="font-mono sm:ml-2"><%= bill.no_sambung %></span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center">
          <span class="text-gray-500 text-xs sm:text-sm">Periode</span>
          <span class="font-medium sm:ml-2"><%= bill.bulan %>/<%= bill.tahun %></span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center">
          <span class="text-gray-500 text-xs sm:text-sm">Total Tagihan</span>
          <span class="font-bold sm:ml-2">Rp <%= (Number(bill.tagihan) + Number(bill.denda)).toLocaleString('id-ID') %></span>
        </div>
      </div>

      <% if (!locals.success) { %>
      <form action="/bill/<%= bill.id %>/pay" method="POST" class="mt-6">
        <input type="hidden" name="id" value="<%= bill.id %>">
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 sm:p-4 mb-4 sm:mb-6 text-xs sm:text-sm text-yellow-800">
          ⚠️ Konfirmasi pembayaran tagihan periode <strong><%= bill.bulan %>/<%= bill.tahun %></strong>
        </div>
        <button type="submit"
          class="w-full bg-green-600 hover:bg-green-700 active:bg-green-800 text-white font-semibold py-3.5 sm:py-3 px-6 rounded-lg transition text-base sm:text-lg min-h-[48px] focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
          ✅ Konfirmasi Bayar — Rp <%= (Number(bill.tagihan) + Number(bill.denda)).toLocaleString('id-ID') %>
        </button>
      </form>
      <% } %>
    </div>
  </div>
</body>
</html>
