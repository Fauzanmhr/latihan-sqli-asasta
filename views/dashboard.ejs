<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Perusahaan Air Minum Daerah</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
  <nav class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex justify-between h-14 md:h-16 items-center">
        <span class="text-base md:text-lg font-bold text-blue-800">Perusahaan Air Minum Daerah</span>
        <div class="flex items-center gap-2 md:gap-4">
          <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full"><%= user.role %></span>
          <span class="text-sm text-gray-600 truncate max-w-[120px] md:max-w-none"><%= user.nama_lengkap %></span>
          <a href="/logout" class="text-sm text-red-500 hover:text-red-700">Logout</a>
        </div>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-4 md:py-6">
    <h2 class="text-lg md:text-xl font-semibold text-gray-800 mb-6">Selamat Datang, <%= user.nama_lengkap %> 👋</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-8">
      <div class="bg-white rounded-xl shadow-sm border p-4 md:p-6">
        <div class="flex items-center gap-3">
          <div class="p-3 bg-blue-100 rounded-lg shrink-0">
            <svg class="w-5 h-5 md:w-6 md:h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm text-gray-500">Total Pelanggan</p>
            <p class="text-xl md:text-2xl font-bold text-gray-800"><%= stats.totalPelanggan %></p>
          </div>
        </div>
      </div>
      <div class="bg-white rounded-xl shadow-sm border p-4 md:p-6">
        <div class="flex items-center gap-3">
          <div class="p-3 bg-yellow-100 rounded-lg shrink-0">
            <svg class="w-5 h-5 md:w-6 md:h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm text-gray-500">Tagihan Belum Bayar</p>
            <p class="text-xl md:text-2xl font-bold text-gray-800"><%= stats.tagihanBelum %></p>
          </div>
        </div>
      </div>
      <div class="bg-white rounded-xl shadow-sm border p-4 md:p-6">
        <div class="flex items-center gap-3">
          <div class="p-3 bg-red-100 rounded-lg shrink-0">
            <svg class="w-5 h-5 md:w-6 md:h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm text-gray-500">Total Piutang</p>
            <p class="text-xl md:text-2xl font-bold text-gray-800">Rp <%= Number(stats.totalPiutang).toLocaleString('id-ID') %></p>
          </div>
        </div>
      </div>
    </div>

    <h3 class="text-base md:text-lg font-semibold text-gray-700 mb-4">Menu</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a href="/customers" class="bg-white rounded-xl shadow-sm border p-4 md:p-6 hover:shadow-md hover:border-blue-300 transition group">
        <div class="flex items-center gap-3">
          <div class="p-3 bg-blue-50 rounded-lg group-hover:bg-blue-100 shrink-0">
            <svg class="w-5 h-5 md:w-6 md:h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-medium text-gray-800">Data Pelanggan</p>
            <p class="text-sm text-gray-500">Cari, detail, edit, bayar tagihan</p>
          </div>
        </div>
      </a>
      <a href="/meter" class="bg-white rounded-xl shadow-sm border p-4 md:p-6 hover:shadow-md hover:border-orange-300 transition group">
        <div class="flex items-center gap-3">
          <div class="p-3 bg-orange-50 rounded-lg group-hover:bg-orange-100 shrink-0">
            <svg class="w-5 h-5 md:w-6 md:h-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-medium text-gray-800">Input Meter</p>
            <p class="text-sm text-gray-500">Catat pemakaian & buat tagihan</p>
          </div>
        </div>
      </a>
      <a href="/export" class="bg-white rounded-xl shadow-sm border p-4 md:p-6 hover:shadow-md hover:border-purple-300 transition group">
        <div class="flex items-center gap-3">
          <div class="p-3 bg-purple-50 rounded-lg group-hover:bg-purple-100 shrink-0">
            <svg class="w-5 h-5 md:w-6 md:h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-medium text-gray-800">Ekspor Data</p>
            <p class="text-sm text-gray-500">CSV export</p>
          </div>
        </div>
      </a>
    </div>
  </div>
</body>
</html>